OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
# модель-кодер: пишет и правит игру
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
# планировщик (дешёвая), исправитель (пусто = кодер), запасные через запятую
LLM_PLANNER_MODEL=deepseek/deepseek-v4.1-flash
LLM_FIXER_MODEL=
LLM_FALLBACK_MODELS=deepseek/deepseek-v4-pro
LLM_MAX_TOKENS=32000
MAX_FIX_ROUNDS=2
# рассуждения «думающих» моделей: off | low | medium | high (они тратят тот же лимит LLM_MAX_TOKENS)
LLM_REASONING=low
# headless Chrome для автотеста игр; пусто = только статическая проверка
BROWSER_WS_URL=ws://browser:9222

DATABASE_URL=
JWT_SECRET=super_secret_key

PUBLIC_BASE_URL=http://localhost:8080
MANAGER_CODE=

MAX_CONCURRENT_GEN=8
LLM_TIMEOUT_SEC=240

POSTGRES_PASSWORD=
PORT=
FRONTEND_PORT=
